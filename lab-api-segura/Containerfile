FROM docker.io/library/python:3.12-slim
RUN useradd -u 10001 -m appuser
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY app.py app_vulnerable.py ./
RUN mkdir -p /app/data /app/keys && chown appuser /app/data /app/keys
USER appuser
ENV DB_PATH=/app/data/inventario.db KEY_PATH=/app/keys/private.pem
EXPOSE 5002
# 1 worker: el rate limiter vive en memoria (con varios workers usar Redis)
CMD ["gunicorn", "-w", "1", "--threads", "4", "-b", "0.0.0.0:5002", "app:app"]
