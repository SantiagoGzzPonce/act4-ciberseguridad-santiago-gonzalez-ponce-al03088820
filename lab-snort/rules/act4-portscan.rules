# ---------------------------------------------------------------------------
# Reglas personalizadas Act4 - deteccion de escaneos de puertos (Snort 2.9.x)
# Compatibles con el paquete Snort de pfSense: Services > Snort > <iface> Rules >
# custom.rules. SID >= 1000000 (rango reservado para reglas locales).
# threshold type both: alerta UNA vez por origen cuando se supera el umbral en la
# ventana, para no inundar el log con una alerta por paquete.
# ---------------------------------------------------------------------------

# 1) SYN scan (nmap -sS): muchos SYN sin completar handshake desde un mismo origen
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"ACT4 SCAN SYN - posible nmap -sS"; flow:stateless; flags:S,12; threshold:type both, track by_src, count 20, seconds 5; classtype:attempted-recon; sid:1000001; rev:2;)

# 2) Connect scan (nmap -sT): muchos intentos de conexion completos -> RST del servidor
alert tcp $HOME_NET any -> $EXTERNAL_NET any (msg:"ACT4 SCAN puertos cerrados - RST masivos al mismo origen"; flow:stateless; flags:RA; threshold:type both, track by_dst, count 20, seconds 5; classtype:attempted-recon; sid:1000002; rev:1;)

# 3) NULL scan (nmap -sN): TCP sin ninguna bandera
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"ACT4 SCAN NULL - nmap -sN"; flow:stateless; flags:0; threshold:type both, track by_src, count 5, seconds 10; classtype:attempted-recon; sid:1000003; rev:1;)

# 4) FIN scan (nmap -sF)
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"ACT4 SCAN FIN - nmap -sF"; flow:stateless; flags:F,12; threshold:type both, track by_src, count 5, seconds 10; classtype:attempted-recon; sid:1000004; rev:1;)

# 5) XMAS scan (nmap -sX): FIN+PSH+URG
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"ACT4 SCAN XMAS - nmap -sX"; flow:stateless; flags:FPU,12; threshold:type both, track by_src, count 5, seconds 10; classtype:attempted-recon; sid:1000005; rev:1;)

# 6) Deteccion de version / scripts de nmap por User-Agent HTTP (nmap -sV / -sC / NSE)
alert tcp $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (msg:"ACT4 SCAN Nmap Scripting Engine (User-Agent)"; flow:to_server,established; content:"Nmap Scripting Engine"; http_header; nocase; classtype:web-application-attack; sid:1000006; rev:1;)

# 7) Barrido ICMP (nmap -sn / ping sweep)
alert icmp $EXTERNAL_NET any -> $HOME_NET any (msg:"ACT4 SCAN barrido ICMP echo"; itype:8; threshold:type both, track by_src, count 10, seconds 5; classtype:attempted-recon; sid:1000007; rev:1;)
