# Equipos del laboratorio (servidores, PCs, IoT, atacante, "Internet")
FROM docker.io/library/ubuntu:24.04
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      iproute2 dnsutils curl nmap python3 netcat-openbsd dnsmasq && rm -rf /var/lib/apt/lists/*
